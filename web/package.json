{
  "name": "yuholens-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "dev": "pnpm content && next dev",
    "build": "pnpm content && next build",
    "start": "next start",
    "build:og": "tsx scripts/build-og.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:e2e"
  },
  "dependencies": {
    "framer-motion": "^11.11.0",
    "lenis": "^1.3.23",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@next/bundle-analyzer": "^15.0.0",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.59.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.0",
    "serve": "^14.2.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
